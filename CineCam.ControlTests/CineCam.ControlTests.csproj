<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="CineCam.Localization" />
    <Compile Include="..\CineCam\Localization\*.cs" Link="Localization\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\CineCam\Localization\*.json" LogicalName="CineCam.Localization.%(Filename)%(Extension)" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <Compile Include="..\CineCam\Director\**\*.cs" Link="Director\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\CineCam\Editing\**\*.cs" Link="Editing\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\CineCam\Features\Look\PictureGuard.cs" Link="Features\PictureGuard.cs" />
    <Compile Include="..\CineCam\Features\Look\FrameStats.cs" Link="Features\FrameStats.cs" />
    <Compile Include="..\CineCam\Features\Look\StillCapture.cs" Link="Features\StillCapture.cs" />
    <Compile Include="..\CineCam\Features\Takes\OfflineHooks.cs" Link="Features\OfflineHooks.cs" />
  </ItemGroup>
</Project>
