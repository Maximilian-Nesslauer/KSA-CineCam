<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="StarMap.API" Version="0.5.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="KSA">
      <HintPath>..\..\..\refs\game\KSA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Numerics">
      <HintPath>..\..\..\refs\game\Brutal.Numerics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Logging">
      <HintPath>..\..\..\refs\game\Brutal.Logging.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.ImGui">
      <HintPath>..\..\..\refs\game\Brutal.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.ImGui.Abstractions">
      <HintPath>..\..\..\refs\game\Brutal.ImGui.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Glfw">
      <HintPath>..\..\..\refs\game\Brutal.Glfw.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core">
      <HintPath>..\..\..\refs\game\Brutal.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Vulkan.Abstractions">
      <HintPath>..\..\..\refs\game\Brutal.Vulkan.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Planet.Render.Core">
      <HintPath>..\..\..\refs\game\Planet.Render.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepuUtilities">
      <HintPath>..\..\..\refs\game\BepuUtilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
  <ItemGroup>
    <PatchFile Include="Patches\*.xml" />
  </ItemGroup>
  -->

  <ItemGroup>
    <None Update="mod.toml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Deploy into the game's mods folder, plus the worktree-safety and game-is-running
       guards. Any @(PatchFile) items declared above are picked up automatically. -->
  <Import Project="..\build\ModDeploy.targets" />

  <Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ReleaseDir>$(OutputPath)release\$(AssemblyName)\</ReleaseDir>
      <ZipPath>$(OutputPath)$(AssemblyName).zip</ZipPath>
    </PropertyGroup>
    <RemoveDir Directories="$(OutputPath)release" />
    <MakeDir Directories="$(ReleaseDir)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ReleaseDir)" />
    <Copy SourceFiles="mod.toml" DestinationFolder="$(ReleaseDir)" />
    <Copy SourceFiles="..\scripts\cinecam.py" DestinationFolder="$(ReleaseDir)" Condition="Exists('..\scripts\cinecam.py')" />
    <!--
    <MakeDir Directories="$(ReleaseDir)Patches\" />
    <Copy SourceFiles="@(PatchFile)" DestinationFolder="$(ReleaseDir)Patches\" />
    -->
    <ZipDirectory SourceDirectory="$(OutputPath)release" DestinationFile="$(ZipPath)" Overwrite="true" />
    <RemoveDir Directories="$(OutputPath)release" />
    <Message Importance="high" Text="Release packaged: $(ZipPath)" />
  </Target>

</Project>
