<Project Sdk="Microsoft.NET.Sdk">

  <!-- A console test runner for the game-free code and capture hooks with stand-ins for KSA. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>CineCam.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <Compile Include="..\CineCam.ControlTests\ControlGameStubs.cs" Link="Capture\ControlGameStubs.cs" />
    <Compile Include="..\CineCam\Features\Look\FrameStats.cs" Link="Capture\FrameStats.cs" />
    <Compile Include="..\CineCam\Features\Look\PictureGuard.cs" Link="Capture\PictureGuard.cs" />
    <Compile Include="..\CineCam\Features\Look\StillCapture.cs" Link="Capture\StillCapture.cs" />
    <Compile Include="..\CineCam\Features\Takes\OfflineHooks.cs" Link="Capture\OfflineHooks.cs" />
    <Compile Include="..\CineCam\Features\Takes\SaveLoadWatch.cs" Link="SaveLoadWatch.cs" />
    <Compile Include="..\CineCam\Features\Takes\CheckpointLoadGuard.cs" Link="CheckpointLoadGuard.cs" />
    <Using Include="CineCam.Localization" />
    <None Include="..\tools\LocalizationCheck\shots.json" Link="LocalizationShots.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\CineCam\Localization\*.cs" Link="Localization\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\CineCam\Localization\*.json" LogicalName="CineCam.Localization.%(Filename)%(Extension)" />
    <Compile Include="..\CineCam\Director\**\*.cs" Link="Director\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\CineCam\Editing\**\*.cs" Link="Editing\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\CineCam\Api\**\*.cs" Link="Api\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
