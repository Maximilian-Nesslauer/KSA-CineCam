<Project Sdk="Microsoft.NET.Sdk">

  <!-- A plain console test runner. It compiles only the game-free director and editing files, so it never
       loads KSA.dll. It exits with 0 when every test passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>CineCam.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\CineCam\Director\**\*.cs" Link="Director\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\CineCam\Editing\**\*.cs" Link="Editing\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
